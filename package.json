{
  "name": "ice-wolf",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "ICE WOLF — a 3D social-deduction freeze tag game (Three.js + Capacitor iOS shell)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node scripts/verify-browser.mjs",
    "verify": "npm test && npm run build && python3 scripts/ios/verify-ios-project.py",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:build": "bash scripts/ios/build-and-upload-testflight.sh",
    "ios:upload": "bash scripts/ios/build-and-upload-testflight.sh --upload"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
